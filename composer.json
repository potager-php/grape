{
    "name": "potagerphp/grape",
    "description": "Type-safe schema validation and data sanitization for PHP 8.2+.",
    "type": "library",
    "homepage": "https://github.com/potager-php/grape",
    "support": {
        "source": "https://github.com/potager-php/grape",
        "issues": "https://github.com/potager-php/grape/issues"
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Potager\\Grape\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Theo",
            "email": "your-email@example.com"
        }
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^3.8",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
